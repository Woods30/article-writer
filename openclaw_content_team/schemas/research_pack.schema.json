        "module_b",
        "module_c",
        "module_d",
        "module_e"
      ],
      "properties": {
        "module_a": {
          "type": "string"
        },
        "module_b": {
          "type": "string"
        },
        "module_c": {
          "type": "string"
        },
        "module_d": {
          "type": "string"
        },
        "module_e": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "high_risk_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "key_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_human_confirmations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
