{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PerformanceDataInput",
  "type": "object",
  "required": [
    "published_items"
  ],
  "properties": {
    "published_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "platform",
          "metrics"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          }
        }
      }
    }
  }
}
