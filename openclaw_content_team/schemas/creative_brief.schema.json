{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeBrief",
  "type": "object",
  "required": [
    "output",
    "key_summary",
    "next_agent_focus",
    "pending_human_confirmations"
  ],
  "properties": {
    "output": {
      "type": "object",
      "required": [
        "core_proposition",
        "target_audience",
        "outline",
        "evidence_gap_list"
      ],
      "properties": {
        "core_proposition": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_gap_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platform_strategy": {
          "type": "object",
          "properties": {
            "wechat": {
              "type": "string"
            },
            "xiaohongshu": {
              "type": "string"
            }
          }
        }
      }
    },
    "key_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_human_confirmations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
