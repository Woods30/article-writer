{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImagePrompts",
  "type": "object",
  "required": [
    "output",
    "key_summary",
    "next_agent_focus",
    "pending_human_confirmations"
  ],
  "properties": {
    "output": {
      "type": "object",
      "required": [
        "midjourney_prompts",
        "dalle_prompts"
      ],
      "properties": {
        "midjourney_prompts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "dalle_prompts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "key_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_human_confirmations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
