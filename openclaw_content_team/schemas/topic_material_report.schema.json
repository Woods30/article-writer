{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TopicMaterialReport",
  "type": "object",
  "required": [
    "output",
    "key_summary",
    "next_agent_focus",
    "pending_human_confirmations"
  ],
  "properties": {
    "output": {
      "type": "object",
      "required": [
        "candidate_topics"
      ],
      "properties": {
        "candidate_topics": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "topic",
              "audience",
              "trigger",
              "evidence"
            ],
            "properties": {
              "topic": {
                "type": "string"
              },
              "audience": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risk_note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "key_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_human_confirmations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
