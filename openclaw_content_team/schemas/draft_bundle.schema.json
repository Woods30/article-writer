{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DraftBundle",
  "type": "object",
  "required": [
    "output",
    "key_summary",
    "next_agent_focus",
    "pending_human_confirmations"
  ],
  "properties": {
    "output": {
      "type": "object",
      "required": [
        "wechat_draft_markdown",
        "xiaohongshu_draft_markdown"
      ],
      "properties": {
        "wechat_draft_markdown": {
          "type": "string"
        },
        "xiaohongshu_draft_markdown": {
          "type": "string"
        }
      }
    },
    "key_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_human_confirmations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
